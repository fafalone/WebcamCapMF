[Description("")]
[FormDesignerId("CD32D1B6-6319-4084-A668-8779105D6A12")]
[PredeclaredId]
Class Form1

    Private m_pActivateDevices() As IMFActivate   ' module-level, keeps refs alive for later use  
    Private m_pSourceReader As IMFSourceReader
    Private m_pMediaSource As IMFMediaSource
    Private m_pReaderCallback As CSourceReaderCallback
    Private m_activeDeviceIndex As Long
    Private m_capturedFrameBytes() As Byte
    Private m_capturedWidth As Long, m_capturedHeight As Long
    
    Private Type tModes
        cx As Long
        cy As Long
        fmt As UUID
    End Type
    Private m_Modes() As tModes
    Private m_cntModes As Long
    

    Private Const SUBCLASS_ID_WEBCAM As LongPtr = 1001
    Private Const WM_MF_FRAMEREADY As Long = &H8001&   ' arbitrary WM_APP+ value, define once app-wide
    
    Public Function EnumerateWebcams() As Boolean
        Dim pAttributes As IMFAttributes
        Dim ppDevices As LongPtr
        Dim cDevices As Long
        Dim hr As Long

        lstCams.Clear
        Erase m_pActivateDevices

        hr = MFCreateAttributes(pAttributes, 1)
        If hr < 0 Then Return False

        pAttributes.SetGuid(MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE, _
                             MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID)

        hr = MFEnumDeviceSources(pAttributes, ppDevices, cDevices)
        If hr < 0 Or cDevices = 0 Then Return False

        ReDim m_pActivateDevices(0 To cDevices - 1)

        Dim i As Long
        Dim pElemPtr As LongPtr
        Dim pActivate As IMFActivate
        Dim pFriendlyName As LongPtr
        Dim cchLen As Long

        For i = 0 To cDevices - 1
            CopyMemory(ByVal VarPtr(pElemPtr), ByVal ppDevices + i * LenB(Of LongPtr), LenB(Of LongPtr))

            vbaObjSetAddref pActivate, pElemPtr     ' wrap raw ptr as interface (adds a ref)()
            Set m_pActivateDevices(i) = pActivate

            cchLen = pActivate.GetAllocatedString(MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME, _
                                               pFriendlyName)
            If Err.LastHresult >= 0 Then
                lstCams.AddItem(LPWSTRtoStr(pFriendlyName))
            Else
                lstCams.AddItem("Unknown device " & i)
            End If
        Next i

        CoTaskMemFree(ppDevices)   ' free the enumeration array itself, once, after the loop
        Return True
    End Function
 
    Public Function EnumerateResolutions(deviceIndex As Long, lstResolutions As ListBox) As Boolean
        If deviceIndex < 0 Or deviceIndex > UBound(m_pActivateDevices) Then Return False

        Dim pMediaSource As IMFMediaSource
        Dim pReader As IMFSourceReader
        Dim hr As Long
        On Error Resume Next

        m_cntModes = 0
        Erase m_Modes

          m_pActivateDevices(deviceIndex).ActivateObject(IID_IMFMediaSource, pMediaSource)
        If Err.LastHresult < 0 Then Return False

        hr = MFCreateSourceReaderFromMediaSource(pMediaSource, Nothing, pReader)
        If hr < 0 Then
            pMediaSource.Shutdown()
            Return False
        End If

        lstResolutions.Clear

        Dim i As Long
        Dim pType As IMFMediaType
        Dim frameSize As LongLong
        Dim seenSizes As New Collection

        On Error Resume Next

        i = 0
        Do
            Set pType = pReader.GetNativeMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, i)
            If Err.LastHresult < 0 Then Exit Do

            frameSize = pType.GetUInt64(MF_MT_FRAME_SIZE)

            Dim st As UUID
            st = pType.GetGUID(MF_MT_SUBTYPE)

            If Err.LastHresult >= 0 Then
                Dim w As Long
                Dim h As Long

                w = CLng(frameSize >> 32)
                h = CLng(frameSize Mod 4294967296)

                Dim key As String
                key = w & "x" & h


                If Not seenSizes.Exists(key) Then
                    seenSizes.Add True, key

                    ReDim Preserve m_Modes(0 To m_cntModes)

                    m_Modes(m_cntModes).cx = w
                    m_Modes(m_cntModes).cy = h
                    m_Modes(m_cntModes).fmt = st

                    m_cntModes = m_cntModes + 1

                    lstResolutions.AddItem key
                End If
            End If

            i = i + 1
        Loop

        On Error GoTo 0

        ' pMediaSource.Shutdown()
        m_pActivateDevices(deviceIndex).ShutdownObject()

        Return lstResolutions.ListCount > 0
    End Function
    
    Private Sub Form_Load() Handles Form.Load
        EnumerateWebcams
        SetWindowSubclass(Picture1.hWnd, AddressOf WebcamSubclassProc, SUBCLASS_ID_WEBCAM, 0)
    End Sub
    Private Sub Form_Unload(Cancel As Integer)
        StopWebcamStream()
        RemoveWindowSubclass(Picture1.hWnd, AddressOf WebcamSubclassProc, SUBCLASS_ID_WEBCAM)
    End Sub
    
    
    Private Sub lstCamsAnyClick() Handles lstCams.DblClick, lstCams.Click
        If lstCams.ListIndex <> -1 Then
            Debug.Print lstCams.ListIndex
            EnumerateResolutions(lstCams.ListIndex, lstResolutions)
        End If
    End Sub
     
    Public Function StartWebcamStream(deviceIndex As Long, pichwnd As LongPtr, targetWidth As Long, targetHeight As Long) As Boolean
        Dim hr As Long
        Dim pAttributes As IMFAttributes

        If deviceIndex < 0 Or deviceIndex > UBound(m_pActivateDevices) Then Return False
        If m_pSourceReader IsNot Nothing Then StopWebcamStream()

        m_pActivateDevices(deviceIndex).ActivateObject(IID_IMFMediaSource, m_pMediaSource)
        hr = Err.LastHresult
        If hr < 0 Then Return False

        m_activeDeviceIndex = deviceIndex
        Set m_pReaderCallback = New CSourceReaderCallback

        hr = MFCreateAttributes(pAttributes, 1)
        If hr < 0 Then Return False

        pAttributes.SetUINT32(MF_SOURCE_READER_DISABLE_DXVA, 1)
        If Err.LastHresult < 0 Then Return False

        pAttributes.SetUnknown(MF_SOURCE_READER_ASYNC_CALLBACK, m_pReaderCallback)
        If Err.LastHresult < 0 Then Return False

        pAttributes.SetUINT32(MF_SOURCE_READER_ENABLE_VIDEO_PROCESSING, 1)
        If Err.LastHresult < 0 Then Return False

        hr = MFCreateSourceReaderFromMediaSource(m_pMediaSource, pAttributes, m_pSourceReader)
        If hr < 0 Then Return False

        Dim i As Long
        Dim pNativeType As IMFMediaType
        Dim pChosenType As IMFMediaType
        Dim frameSize As LongLong
        Dim found As Boolean

        On Error Resume Next

        i = 0
        Do
            Set pNativeType = m_pSourceReader.GetNativeMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, i)
            If Err.LastHresult < 0 Then Exit Do

            frameSize = pNativeType.GetUInt64(MF_MT_FRAME_SIZE)
            If Err.LastHresult >= 0 Then
                Dim nativeWidth As Long
                Dim nativeHeight As Long

                nativeWidth = CLng(frameSize >> 32)
                nativeHeight = CLng(frameSize Mod 4294967296)

                If nativeWidth = targetWidth And nativeHeight = targetHeight Then
                    Set pChosenType = pNativeType
                    found = True
                    Exit Do
                End If
            End If

            i = i + 1
        Loop

        If Not found Then Return False

        ' First select the native camera mode.
        ' Do not pass pChosenType itself to the driver.
        Dim pNativeSelected As IMFMediaType

        hr = MFCreateMediaType(pNativeSelected)
        If hr < 0 Then Return False

         pChosenType.CopyAllItems(pNativeSelected)
        If Err.LastHresult < 0 Then Return False

        m_pSourceReader.SetCurrentMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, pNativeSelected)
        If Err.LastHresult < 0 Then Return False

        ' Now request RGB32 output at the same resolution.
        Dim pRGBType As IMFMediaType

        hr = MFCreateMediaType(pRGBType)
        If hr < 0 Then Return False

        pRGBType.SetGuid(MF_MT_MAJOR_TYPE, MFMediaType_Video)
        If Err.LastHresult < 0 Then Return False

        pRGBType.SetGuid(MF_MT_SUBTYPE, MFVideoFormat_RGB32)
        If Err.LastHresult < 0 Then Return False

        pRGBType.SetUINT64(MF_MT_FRAME_SIZE, frameSize)
        If Err.LastHresult < 0 Then Return False

        m_pSourceReader.SetCurrentMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, pRGBType)
        If Err.LastHresult < 0 Then Return False

        ' Verify what the Source Reader actually accepted.
        Dim pActualType As IMFMediaType

        Set pActualType = m_pSourceReader.GetCurrentMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM)
        If Err.LastHresult < 0 Then Return False

        frameSize = pActualType.GetUInt64(MF_MT_FRAME_SIZE)
        If Err.LastHresult < 0 Then Return False

        Dim videoWidth As Long
        Dim videoHeight As Long

        videoWidth = CLng(frameSize >> 32)
        videoHeight = CLng(frameSize Mod 4294967296)

        Debug.Print "Requested: " ; targetWidth ; "x" ; targetHeight
        Debug.Print "Actual: " ; videoWidth ; "x" ; videoHeight
        ' Debug.Print "Subtype: " ; dbg_GUIDToString(pActualType.GetGUID(MF_MT_SUBTYPE))

        If videoWidth <> targetWidth Or videoHeight <> targetHeight Then Return False

                                                                                             
        InitializeD2DTarget(Picture1.hWnd, Picture1.ScaleWidth, Picture1.ScaleHeight, videoWidth, videoHeight)
        
        m_pReaderCallback.Initialize(m_pSourceReader, pichwnd, videoWidth, videoHeight, videoWidth * 4)

         m_pSourceReader.SetStreamSelection(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 1)
        If Err.LastHresult < 0 Then Return False

        m_pSourceReader.ReadSample(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, ByVal 0&, ByVal 0&, ByVal vbNullPtr, ByVal Nothing)
        hr = Err.LastHresult
        
        Frame2.Enabled = True
        Frame3.Enabled = True
        SetAdjustmentRanges
        
        On Error GoTo 0

        Debug.Print Hex$(hr)

        If hr < 0 Then Return False

        Return True
    End Function
    Public Sub StopWebcamStream()
        If m_pSourceReader IsNot Nothing Then
            Set m_pSourceReader = Nothing
        End If
        If m_pMediaSource IsNot Nothing Then
            m_pMediaSource.Shutdown()
            Set m_pMediaSource = Nothing
        End If
        If m_activeDeviceIndex >= 0 And m_activeDeviceIndex <= UBound(m_pActivateDevices) Then
            m_pActivateDevices(m_activeDeviceIndex).ShutdownObject()
        End If
        Set m_pReaderCallback = Nothing
        Frame2.Enabled = False
        Frame3.Enabled = False
    End Sub
    
    Public Function SetVideoProcAmp(prop As VideoProcAmpProperty, Value As Long) As Boolean
        Dim pProcAmp As IAMVideoProcAmp
        Dim hr As Long

        Set pProcAmp = m_pMediaSource
        If Err.LastHresult < 0 Then Return False

        pProcAmp.Set(prop, Value, VideoProcAmp_Flags_Manual)
        If Err.LastHresult < 0 Then Return False

        Return True
    End Function
    Public Function SetCamControl(prop As CameraControlProperty, Value As Long) As Boolean
        Dim pcc As IAMCameraControl
        Set pcc = m_pMediaSource
        If Err.LastHresult < 0 Then Return False

        pcc.Set(prop, Value, VideoProcAmp_Flags_Manual)
        If Err.LastHresult < 0 Then Return False

        Return True
    End Function
    
    Private Function ResetAdjustmentDefaults() As Boolean
        Dim pProcAmp As IAMVideoProcAmp
        Dim hr As Long
        Dim currentFlags As Long
        Dim minVal As Long, maxVal As Long, stepVal As Long, defaultVal As Long, currentVal As Long
        Dim lc As Long
        On Error Resume Next
        
        Set pProcAmp = m_pMediaSource
        If Err.LastHresult < 0 Then Return False

        pProcAmp.GetRange(VideoProcAmp_Brightness, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Brightness, defaultVal, currentFlags)
            sldBrightness.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_Contrast, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Contrast, defaultVal, currentFlags)
            sldContrast.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_Saturation, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Saturation, defaultVal, currentFlags)
            sldSaturation.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_Hue, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Hue, defaultVal, currentFlags)
            sldHue.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_Gain, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Gain, defaultVal, currentFlags)
            sldGain.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_Gamma, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Gamma, defaultVal, currentFlags)
            sldGamma.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_WhiteBalance, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_WhiteBalance, defaultVal, currentFlags)
            sldWhiteBalance.Value = defaultVal
        End If
        pProcAmp.GetRange(VideoProcAmp_Sharpness, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pProcAmp.Set(VideoProcAmp_Sharpness, defaultVal, currentFlags)
            sldSharpness.Value = defaultVal
        End If
        
        
        Dim pcc As IAMCameraControl
        Set pcc = m_pMediaSource
        If Err.LastHresult < 0 Then Return False
        
        pcc.GetRange(CameraControl_Zoom, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            pcc.Set(CameraControl_Zoom, defaultVal, currentFlags)
            sldZoom.Value = defaultVal
        End If
    End Function
        
        
        
    Public Function SetAdjustmentRanges() As Boolean
        Dim pProcAmp As IAMVideoProcAmp
        Dim hr As Long
        Dim currentFlags As Long
        Dim minVal As Long, maxVal As Long, stepVal As Long, defaultVal As Long, currentVal As Long
        Dim lc As Long
        On Error Resume Next
        
        Set pProcAmp = m_pMediaSource
        If Err.LastHresult < 0 Then Return False

        pProcAmp.GetRange(VideoProcAmp_Brightness, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldBrightness.Enabled = True
            sldBrightness.Min = minVal
            sldBrightness.Max = maxVal
            sldBrightness.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldBrightness.LargeChange = If(lc > 1, lc, 1)
            sldBrightness.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Brightness, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldBrightness.Value = currentVal
            Else
                sldBrightness.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Brightness, defaultVal
            End If
        Else
            sldBrightness.Enabled = False
        End If

        pProcAmp.GetRange(VideoProcAmp_Contrast, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldContrast.Enabled = True
            sldContrast.Min = minVal
            sldContrast.Max = maxVal
            sldContrast.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldContrast.LargeChange = If(lc > 1, lc, 1)
            sldContrast.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Contrast, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldContrast.Value = currentVal
            Else
                sldContrast.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Contrast, defaultVal
            End If
        Else
            sldContrast.Enabled = False
        End If
        
        pProcAmp.GetRange(VideoProcAmp_Saturation, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldSaturation.Enabled = True
            sldSaturation.Min = minVal
            sldSaturation.Max = maxVal
            sldSaturation.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldSaturation.LargeChange = If(lc > 1, lc, 1)
            sldSaturation.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Saturation, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldSaturation.Value = currentVal
            Else
                sldSaturation.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Saturation, defaultVal
            End If
        Else
            sldSaturation.Enabled = False
        End If
        
        pProcAmp.GetRange(VideoProcAmp_Gain, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldGain.Enabled = True
            sldGain.Min = minVal
            sldGain.Max = maxVal
            sldGain.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldGain.LargeChange = If(lc > 1, lc, 1)
            sldGain.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Gain, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldGain.Value = currentVal
            Else
                sldGain.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Gain, defaultVal
            End If
        Else
            sldGain.Enabled = False
        End If
        
        pProcAmp.GetRange(VideoProcAmp_Hue, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldHue.Enabled = True
            sldHue.Min = minVal
            sldHue.Max = maxVal
            sldHue.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldHue.LargeChange = If(lc > 1, lc, 1)
            sldHue.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Hue, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldHue.Value = currentVal
            Else
                sldHue.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Hue, defaultVal
            End If
        Else
            sldHue.Enabled = False
        End If
        
        pProcAmp.GetRange(VideoProcAmp_Sharpness, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldSharpness.Enabled = True
            sldSharpness.Min = minVal
            sldSharpness.Max = maxVal
            sldSharpness.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldSharpness.LargeChange = If(lc > 1, lc, 1)
            sldSharpness.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Sharpness, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldSharpness.Value = currentVal
            Else
                sldSharpness.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Sharpness, defaultVal
            End If
        Else
            sldSharpness.Enabled = False
        End If
        
        pProcAmp.GetRange(VideoProcAmp_Gamma, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldGamma.Enabled = True
            sldGamma.Min = minVal
            sldGamma.Max = maxVal
            sldGamma.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldGamma.LargeChange = If(lc > 1, lc, 1)
            sldGamma.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_Gamma, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldGamma.Value = currentVal
            Else
                sldGamma.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_Gamma, defaultVal
            End If
        Else
            sldGamma.Enabled = False
        End If
        
        pProcAmp.GetRange(VideoProcAmp_WhiteBalance, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldWhiteBalance.Enabled = True
            sldWhiteBalance.Min = minVal
            sldWhiteBalance.Max = maxVal
            sldWhiteBalance.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldWhiteBalance.LargeChange = If(lc > 1, lc, 1)
            sldWhiteBalance.TickFrequency = lc
            pProcAmp.Get(VideoProcAmp_WhiteBalance, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldWhiteBalance.Value = currentVal
            Else
                sldWhiteBalance.Value = defaultVal
                SetVideoProcAmp VideoProcAmp_WhiteBalance, defaultVal
            End If
        Else
            sldWhiteBalance.Enabled = False
        End If
        
        Dim pcc As IAMCameraControl
        Set pcc = m_pMediaSource
        If Err.LastHresult < 0 Then Return False
        
        pcc.GetRange(CameraControl_Zoom, minVal, maxVal, stepVal, defaultVal, currentFlags)
        If SUCCEEDED(Err.LastHresult) Then
            sldZoom.Enabled = True
            sldZoom.Min = minVal
            sldZoom.Max = maxVal
            sldZoom.SmallChange = stepVal
            lc = (maxVal - minVal) \ 10
            If lc < stepVal Then lc = stepVal
            sldZoom.LargeChange = If(lc > 1, lc, 1)
            sldZoom.TickFrequency = lc
            pcc.Get(CameraControl_Zoom, currentVal, currentFlags)
            If SUCCEEDED(Err.LastHresult) Then
                sldZoom.Value = currentVal
            Else
                sldZoom.Value = defaultVal
                SetCamControl CameraControl_Zoom, defaultVal
            End If
        Else
            sldZoom.Enabled = False
        End If
        
        Return True
    End Function
    Private Function WebcamSubclassProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByVal uIdSubclass As LongPtr, ByVal dwRefData As LongPtr) As LongPtr
        If uMsg = WM_MF_FRAMEREADY Then
            RenderLatestFrameD2D()
            Return 0
        End If

        Return DefSubclassProc(hWnd, uMsg, wParam, lParam)
    End Function

    Public Sub RenderLatestFrame()
        Dim frameBytes() As Byte
        If Not m_pReaderCallback.GetLatestFrame(frameBytes) Then Return

        Dim bi As BITMAPINFO
        bi.bmiHeader.biSize = LenB(Of BITMAPINFOHEADER)
        bi.bmiHeader.biWidth = m_pReaderCallback.VideoWidth
        bi.bmiHeader.biHeight = -m_pReaderCallback.VideoHeight
        bi.bmiHeader.biPlanes = 1
        bi.bmiHeader.biBitCount = 32
        bi.bmiHeader.biCompression = BI_RGB

        SetStretchBltMode(Picture1.hDC, HALFTONE)
        SetBrushOrgEx(Picture1.hDC, 0, 0, ByVal vbNullPtr)
        StretchDIBits(Picture1.hDC, 0, 0, Picture1.ScaleWidth, Picture1.ScaleHeight, 0, 0, m_pReaderCallback.VideoWidth, m_pReaderCallback.VideoHeight, ByVal VarPtr(frameBytes(0)), bi, DIB_RGB_COLORS, SRCCOPY)
        
        ' Picture1.Refresh
    End Sub
 
    Private Sub cmdCapture_Click()
        Dim frameBytes() As Byte
        If Not m_pReaderCallback.GetLatestFrame(frameBytes) Then Return

        ' Freeze it into the 2nd PictureBox for preview, same as before
        Dim bi As BITMAPINFO
        bi.bmiHeader.biSize = LenB(Of BITMAPINFOHEADER)
        bi.bmiHeader.biWidth = m_pReaderCallback.VideoWidth
        bi.bmiHeader.biHeight = -m_pReaderCallback.VideoHeight
        bi.bmiHeader.biPlanes = 1
        bi.bmiHeader.biBitCount = 32
        bi.bmiHeader.biCompression = BI_RGB

        SetStretchBltMode(Picture2.hDC, HALFTONE)
        SetBrushOrgEx(Picture2.hDC, 0, 0, ByVal vbNullPtr)
        StretchDIBits(Picture2.hDC, 0, 0, Picture2.ScaleWidth, Picture2.ScaleHeight, 0, 0, m_pReaderCallback.VideoWidth, m_pReaderCallback.VideoHeight, ByVal VarPtr(frameBytes(0)), bi, DIB_RGB_COLORS, SRCCOPY)
        ' m_capturePic.Refresh

        ' Hold onto the full-resolution bytes for saving later, independent of PictureBox size
        m_capturedFrameBytes = frameBytes
        m_capturedWidth = m_pReaderCallback.VideoWidth
        m_capturedHeight = m_pReaderCallback.VideoHeight
    End Sub
    Private Sub cmdSave_Click()
    SaveCapturedFrame(Text1.Text)
End Sub
 
Public Function SaveCapturedFrame(destPath As String) As Boolean
    If m_capturedWidth = 0 Or m_capturedHeight = 0 Then Return False

    Dim bi As BITMAPINFOHEADER
    bi.biSize = LenB(Of BITMAPINFOHEADER)
    bi.biWidth = m_capturedWidth
    bi.biHeight = -m_capturedHeight   ' positive: standard bottom-up BMP file order
    bi.biPlanes = 1
    bi.biBitCount = 32
    bi.biCompression = BI_RGB
    bi.biSizeImage = UBound(m_capturedFrameBytes) + 1

    Dim fh As BITMAPFILEHEADER
    fh.bfType = &H4D42
    fh.bfOffBits = LenB(Of BITMAPFILEHEADER) + LenB(Of BITMAPINFOHEADER)
    fh.bfSize = fh.bfOffBits + bi.biSizeImage
    Debug.Print m_capturedWidth, bi.biSizeImage, destPath
    Dim iFile As Integer
    iFile = FreeFile
    Open destPath For Binary Access Write As #iFile
    Put #iFile,, fh
    Put #iFile,, bi
    Put #iFile,, m_capturedFrameBytes
    Close #iFile

    Return True
End Function
Private Sub lstResolutions_DblClick() Handles lstResolutions.DblClick
    If lstResolutions.ListIndex < 0 Then Return

    Dim selectedText As String
    selectedText = lstResolutions.List(lstResolutions.ListIndex)

    Dim xPos As Long
    xPos = InStr(selectedText, "x")
    If xPos = 0 Then Return

    Dim targetWidth As Long
    Dim targetHeight As Long
    targetWidth = CLng(Left$(selectedText, xPos - 1))
    targetHeight = CLng(Mid$(selectedText, xPos + 1))

    If Not StartWebcamStream(lstCams.ListIndex, Picture1.hWnd, targetWidth, targetHeight) Then
        MsgBox("Failed to start stream at " & selectedText)
    End If
End Sub

Private Sub Command1_Click() Handles Command1.Click
    Dim fsd As FileSaveDialog
    Set fsd = New FileSaveDialog
    
    Dim tFilt As COMDLG_FILTERSPEC
    tFilt.pszName = StrPtr("Bitmap")
    tFilt.pszSpec = StrPtr("*.bmp")
    
    fsd.SetTitle("Save bitmap as...")
    fsd.SetFileTypes(1, VarPtr(tFilt))
    fsd.SetFileTypeIndex(0)
    fsd.SetDefaultExtension(".bmp")
    fsd.SetOptions(FOS_STRICTFILETYPES)
    On Error Resume Next
    fsd.Show(Me.hWnd)
    Dim siRes As IShellItem
    fsd.GetResult(siRes)
    If siRes IsNot Nothing Then
        Dim lpPath As LongPtr
        siRes.GetDisplayName(SIGDN_FILESYSPATH, lpPath)
        If lpPath Then
            Text1.Text = LPWSTRtoStr(lpPath)
        End If
    End If
End Sub
 
