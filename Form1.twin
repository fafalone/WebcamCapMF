[Description("")]
[FormDesignerId("CD32D1B6-6319-4084-A668-8779105D6A12")]
[PredeclaredId]
Class Form1

    Private m_pActivateDevices() As IMFActivate   ' module-level, keeps refs alive for later use  
    Private m_pSourceReader As IMFSourceReader
    Private m_pMediaSource As IMFMediaSource
    Private m_pReaderCallback As CSourceReaderCallback
    Private m_activeDeviceIndex As Long
    Private m_capturedFrameBytes() As Byte
    Private m_capturedWidth As Long, m_capturedHeight As Long

    Private Const SUBCLASS_ID_WEBCAM As LongPtr = 1001
    Private Const WM_MF_FRAMEREADY As Long = &H8001&   ' arbitrary WM_APP+ value, define once app-wide
    
    Public Function EnumerateWebcams() As Boolean
        Dim pAttributes As IMFAttributes
        Dim ppDevices As LongPtr
        Dim cDevices As Long
        Dim hr As Long

        lstCams.Clear
        Erase m_pActivateDevices

        hr = MFCreateAttributes(pAttributes, 1)
        If hr < 0 Then Return False

        pAttributes.SetGuid(MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE, _
                             MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID)

        hr = MFEnumDeviceSources(pAttributes, ppDevices, cDevices)
        If hr < 0 Or cDevices = 0 Then Return False

        ReDim m_pActivateDevices(0 To cDevices - 1)

        Dim i As Long
        Dim pElemPtr As LongPtr
        Dim pActivate As IMFActivate
        Dim pFriendlyName As LongPtr
        Dim cchLen As Long

        For i = 0 To cDevices - 1
            CopyMemory(ByVal VarPtr(pElemPtr), ByVal ppDevices + i * LenB(Of LongPtr), LenB(Of LongPtr))

            vbaObjSetAddref pActivate, pElemPtr     ' wrap raw ptr as interface (adds a ref)()
            Set m_pActivateDevices(i) = pActivate

            cchLen = pActivate.GetAllocatedString(MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME, _
                                               pFriendlyName)
            If Err.LastHresult >= 0 Then
                lstCams.AddItem(LPWSTRtoStr(pFriendlyName))
            Else
                lstCams.AddItem("Unknown device " & i)
            End If
        Next i

        CoTaskMemFree(ppDevices)   ' free the enumeration array itself, once, after the loop
        Return True
    End Function
    Public Function EnumerateResolutions(deviceIndex As Long, lstResolutions As ListBox) As Boolean
        If deviceIndex < 0 Or deviceIndex > UBound(m_pActivateDevices) Then Return False

        Dim pMediaSource As IMFMediaSource
        Dim pReader As IMFSourceReader
        Dim hr As Long

        m_pActivateDevices(deviceIndex).ActivateObject(IID_IMFMediaSource, pMediaSource)
        If hr < 0 Then Return False

        hr = MFCreateSourceReaderFromMediaSource(pMediaSource, Nothing, pReader)
        If hr < 0 Then
            pMediaSource.Shutdown()
            Return False
        End If

        lstResolutions.Clear

        Dim i As Long
        Dim pType As IMFMediaType
        Dim frameSize As LongLong
        Dim seenSizes As New Collection
        On Error Resume Next
        i = 0
        Do
            Set pType = pReader.GetNativeMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, i)
            If Err.LastHresult < 0 Then Exit Do

            frameSize = pType.GetUInt64(MF_MT_FRAME_SIZE)
            If Err.LastHresult >= 0 Then
                Dim w As Long, h As Long
                w = CLng(frameSize >> 32)
                h = CLng(frameSize Mod 4294967296)

                Dim key As String
                key = w & "x" & h

                If Not seenSizes.Exists(key) Then
                    seenSizes.Add(True, key)
                    lstResolutions.AddItem(key)
                End If
            End If

            i = i + 1
        Loop

        ' pMediaSource.Shutdown()
        m_pActivateDevices(deviceIndex).ShutdownObject()
        Return lstResolutions.ListCount > 0
    End Function
    Private Sub Form_Load() Handles Form.Load
        EnumerateWebcams
        SetWindowSubclass(Picture1.hWnd, AddressOf WebcamSubclassProc, SUBCLASS_ID_WEBCAM, 0)
        
    End Sub
    Private Sub Form_Unload(Cancel As Integer)
        StopWebcamStream()
        RemoveWindowSubclass(Picture1.hWnd, AddressOf WebcamSubclassProc, SUBCLASS_ID_WEBCAM)
    End Sub
    
    
    Private Sub lstCamsAnyClick() Handles lstCams.DblClick, lstCams.Click
        If lstCams.ListIndex <> -1 Then
            Debug.Print lstCams.ListIndex
            EnumerateResolutions(lstCams.ListIndex, lstResolutions)
        End If
    End Sub
    
    Public Function StartWebcamStream(deviceIndex As Long, pichwnd As LongPtr, targetWidth As Long, targetHeight As Long) As Boolean
        Dim hr As Long
        Dim pAttributes As IMFAttributes
        If deviceIndex < 0 Or deviceIndex > UBound(m_pActivateDevices) Then Return False
        If m_pSourceReader IsNot Nothing Then StopWebcamStream()
        m_pActivateDevices(deviceIndex).ActivateObject(IID_IMFMediaSource, m_pMediaSource)
        If hr < 0 Then Return False
        m_activeDeviceIndex = deviceIndex
        Set m_pReaderCallback = New CSourceReaderCallback
        
        hr = MFCreateAttributes(pAttributes, 1)
        If hr < 0 Then Return False
        pAttributes.SetUINT32(MF_SOURCE_READER_DISABLE_DXVA, 1)
        pAttributes.SetUnknown(MF_SOURCE_READER_ASYNC_CALLBACK, m_pReaderCallback)
        pAttributes.SetUINT32(MF_SOURCE_READER_ENABLE_VIDEO_PROCESSING, 1)
    
        hr = MFCreateSourceReaderFromMediaSource(m_pMediaSource, pAttributes, m_pSourceReader)
        If hr < 0 Then Return False

        Dim i As Long
        Dim pNativeType As IMFMediaType
        Dim pChosenType As IMFMediaType
        Dim frameSize As LongLong
        Dim found As Boolean
        On Error Resume Next
        i = 0
        Do
            Set pNativeType = m_pSourceReader.GetNativeMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, i)
            If Err.ReturnHResult < 0 Then Exit Do

            frameSize = pNativeType.GetUInt64(MF_MT_FRAME_SIZE)
            If Err.ReturnHResult >= 0 Then
                If CLng(frameSize >> 32) = targetWidth And CLng(frameSize Mod 4294967296) = targetHeight Then
                    Set pChosenType = pNativeType
                    found = True
                    Exit Do
                End If
            End If

            i = i + 1
        Loop

        If Not found Then Return False

        Dim pMediaType As IMFMediaType
        hr = MFCreateMediaType(pMediaType)
        If hr < 0 Then Return False
        
        pChosenType.CopyAllItems(pMediaType)
        pMediaType.SetGuid(MF_MT_SUBTYPE, MFVideoFormat_RGB32)
        m_pSourceReader.SetCurrentMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, pMediaType)
        If Err.ReturnHResult < 0 Then Return False
        
        Dim pActualType As IMFMediaType
        Set pActualType = m_pSourceReader.GetCurrentMediaType(MF_SOURCE_READER_FIRST_VIDEO_STREAM)
        If Err.ReturnHResult < 0 Then Return False
        
        frameSize = pActualType.GetUInt64(MF_MT_FRAME_SIZE)
        If Err.ReturnHResult < 0 Then Return False
        Dim videoWidth As Long, videoHeight As Long
        videoWidth = CLng(frameSize >> 32)
        videoHeight = CLng(frameSize Mod 4294967296)
        m_pReaderCallback.Initialize(m_pSourceReader, pichwnd, videoWidth, videoHeight, _
                                      videoWidth * 4)
        m_pSourceReader.SetStreamSelection(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 1)
 
    
        On Error Resume Next
        m_pSourceReader.ReadSample(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, ByVal 0&, ByVal 0&, ByVal vbNullPtr, ByVal Nothing)
        Debug.Print Hex$(Err.LastHresult)
        If Err.ReturnHResult < 0 Then Return False
        Return True
    End Function
    
    Public Sub StopWebcamStream()
        If m_pSourceReader IsNot Nothing Then
            Set m_pSourceReader = Nothing
        End If
        If m_pMediaSource IsNot Nothing Then
            m_pMediaSource.Shutdown()
            Set m_pMediaSource = Nothing
        End If
        If m_activeDeviceIndex >= 0 And m_activeDeviceIndex <= UBound(m_pActivateDevices) Then
            m_pActivateDevices(m_activeDeviceIndex).ShutdownObject()
        End If
        Set m_pReaderCallback = Nothing
    End Sub
    
    Private Function WebcamSubclassProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByVal uIdSubclass As LongPtr, ByVal dwRefData As LongPtr) As LongPtr
        If uMsg = WM_MF_FRAMEREADY Then
            RenderLatestFrame()
            Return 0
        End If

        Return DefSubclassProc(hWnd, uMsg, wParam, lParam)
    End Function

    Public Sub RenderLatestFrame()
        Dim frameBytes() As Byte
        If Not m_pReaderCallback.GetLatestFrame(frameBytes) Then Return

        Dim bi As BITMAPINFO
        bi.bmiHeader.biSize = LenB(Of BITMAPINFOHEADER)
        bi.bmiHeader.biWidth = m_pReaderCallback.VideoWidth
        bi.bmiHeader.biHeight = -m_pReaderCallback.VideoHeight
        bi.bmiHeader.biPlanes = 1
        bi.bmiHeader.biBitCount = 32
        bi.bmiHeader.biCompression = BI_RGB

        SetDIBitsToDevice(Picture1.hDC, 0, 0, m_pReaderCallback.VideoWidth, m_pReaderCallback.VideoHeight, 0, 0, 0, m_pReaderCallback.VideoHeight, ByVal VarPtr(frameBytes(0)), bi, DIB_RGB_COLORS)

        ' Picture1.Refresh
    End Sub
 
