Private m_pD2DFactory As ID2D1Factory
Private m_pRenderTarget As ID2D1HwndRenderTarget
Private m_pD2DBitmap As ID2D1Bitmap

Public Function InitializeD2DTarget(hwndTarget As LongPtr, displayWidth As Long, displayHeight As Long, sourceWidth As Long, sourceHeight As Long) As Boolean
    Dim hr As Long

    Set m_pD2DBitmap = Nothing

    If m_pRenderTarget Is Nothing Then
        If m_pD2DFactory Is Nothing Then
            hr = D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, IID_ID2D1Factory, ByVal 0, m_pD2DFactory)
            If hr < 0 Then Return False
        End If

        Dim rtProps As D2D1_RENDER_TARGET_PROPERTIES
        Dim hwndProps As D2D1_HWND_RENDER_TARGET_PROPERTIES
        hwndProps.hwnd = hwndTarget
        hwndProps.pixelSize.width = displayWidth
        hwndProps.pixelSize.Height = displayHeight

        Set m_pRenderTarget = m_pD2DFactory.CreateHwndRenderTarget(rtProps, hwndProps)
        If hr < 0 Then Return False
    Else
        Dim sz1 As D2D1_SIZE_U
        sz1.width = displayWidth
        sz1.Height = displayHeight
        m_pRenderTarget.Resize(sz1)
        If Err.LastHresult < 0 Then Return False
    End If

    Dim bmpProps As D2D1_BITMAP_PROPERTIES
    bmpProps.PixelFormat.Format = DXGI_FORMAT_B8G8R8A8_UNORM
    bmpProps.PixelFormat.AlphaMode = D2D1_ALPHA_MODE_IGNORE

    Dim sz As D2D1_SIZE_U
    sz.width = sourceWidth
    sz.Height = sourceHeight

    Set m_pD2DBitmap = m_pRenderTarget.CreateBitmap(sz, ByVal vbNullPtr, 0, bmpProps)
    If hr < 0 Then Return False

    Return True
End Function

Public Sub RenderLatestFrameD2D()
    Dim frameBytes() As Byte
    If Not m_pReaderCallback.GetLatestFrame(frameBytes) Then Return

    Dim srcRect As D2D1_RECT_U
    srcRect.Right = m_pReaderCallback.VideoWidth
    srcRect.Bottom = m_pReaderCallback.VideoHeight

    m_pD2DBitmap.CopyFromMemory(srcRect, frameBytes(0), m_pReaderCallback.VideoWidth * 4)

    m_pRenderTarget.BeginDraw()

    Dim destRect As D2D1_RECT_F
    destRect.Right = Picture1.ScaleWidth
    destRect.Bottom = Picture1.ScaleHeight

    m_pRenderTarget.DrawBitmap(m_pD2DBitmap, destRect, 1.0, D2D1_BITMAP_INTERPOLATION_MODE_LINEAR, ByVal vbNullPtr)

    m_pRenderTarget.EndDraw(ByVal vbNullPtr, ByVal vbNullPtr)
End Sub
End Class

Class CSourceReaderCallback
 
Implements IMFSourceReaderCallback

Private m_pSourceReader As IMFSourceReader
Private m_hwndNotify As LongPtr        ' window to PostMessage to (UI thread owns it)
Private m_videoWidth As Long
Private m_videoHeight As Long
Private m_streamStride As Long

Private m_critSec As CRITICAL_SECTION
Private m_frameBuffer() As Byte
Private m_frameBufferLen As Long
Private m_hasFrame As Boolean

Private Const WM_MF_FRAMEREADY As Long = &H8001&   ' arbitrary WM_APP+ value, define once app-wide

Public Sub Initialize(pReader As IMFSourceReader, hwndNotify As LongPtr, _
                       width As Long, height As Long, stride As Long)
    Set m_pSourceReader = pReader
    m_hwndNotify = hwndNotify
    m_videoWidth = width
    m_videoHeight = height
    m_streamStride = stride
    InitializeCriticalSection(m_critSec)
    ReDim m_frameBuffer(0)
End Sub

Private Sub IMFSourceReaderCallback_OnReadSample(ByVal hrStatus As Long, ByVal dwStreamIndex As MfSourceReaderDefaultStreamIndexes, ByVal dwStreamFlags As Long, ByVal llTimestamp As LongLong, ByVal pSample As IMFSample)

    If hrStatus < 0 Then
        Err.ReturnHResult = hrStatus
        Exit Sub
    End If

    If pSample IsNot Nothing Then
        CopySampleIntoBuffer(pSample)
        PostMessage(m_hwndNotify, WM_MF_FRAMEREADY, 0, 0)
    End If

    Dim pDiscardSample As IMFSample

    If (dwStreamFlags And MF_SOURCE_READERF_ENDOFSTREAM) = 0 Then
        ' Set pDiscardSample = m_pSourceReader.ReadSample(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, _
        '                             ByVal 0&, ByVal 0&, ByVal 0&)
        Dim dummyStreamIndex As Long
        Dim dummyStreamFlags As MF_SOURCE_READER_FLAG
        Dim dummyTimestamp As LongLong

        m_pSourceReader.ReadSample(MF_SOURCE_READER_FIRST_VIDEO_STREAM, 0, ByVal 0&, ByVal 0&, ByVal vbNullPtr, ByVal Nothing)
        
    End If

    
End Sub

Private Sub CopySampleIntoBuffer(pSample As IMFSample)
    Dim pBuffer As IMFMediaBuffer
    Dim pData As LongPtr
    Dim cbMaxLen As Long
    Dim cbCurrentLen As Long
    Dim hr As Long

    Set pBuffer = pSample.ConvertToContiguousBuffer()
    If hr < 0 Then Return

    pBuffer.Lock(pData, cbMaxLen, cbCurrentLen)
    If hr < 0 Then Return

    EnterCriticalSection(m_critSec)
        If UBound(m_frameBuffer) + 1 <> cbCurrentLen Then
            ReDim m_frameBuffer(0 To cbCurrentLen - 1)
        End If
        CopyMemory(ByVal VarPtr(m_frameBuffer(0)), ByVal pData, cbCurrentLen)
        m_frameBufferLen = cbCurrentLen
        m_hasFrame = True
    LeaveCriticalSection(m_critSec)

    pBuffer.Unlock()
End Sub

' Called from the UI thread (message handler) — copies the buffer out under lock
' so the worker thread can keep writing to it concurrently without tearing what
' the UI thread reads.
Public Function GetLatestFrame(ByRef outBytes() As Byte) As Boolean
    If Not m_hasFrame Then Return False

    EnterCriticalSection(m_critSec)
        ReDim outBytes(0 To m_frameBufferLen - 1)
        CopyMemory(ByVal VarPtr(outBytes(0)), ByVal VarPtr(m_frameBuffer(0)), m_frameBufferLen)
    LeaveCriticalSection(m_critSec)

    Return True
End Function

Public Property Get VideoWidth() As Long
    VideoWidth = m_videoWidth
End Property

Public Property Get VideoHeight() As Long
    VideoHeight = m_videoHeight
End Property

 
Private Sub Class_Terminate()
    DeleteCriticalSection(m_critSec)
End Sub

Private Sub IMFSourceReaderCallback_OnEvent(ByVal dwStreamIndex As MfSourceReaderDefaultStreamIndexes, ByVal pEvent As IMFMediaEvent) Implements IMFSourceReaderCallback.OnEvent
    
End Sub

Private Sub IMFSourceReaderCallback_OnFlush(ByVal dwStreamIndex As MfSourceReaderDefaultStreamIndexes) Implements IMFSourceReaderCallback.OnFlush
    
End Sub

End Class